<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        {% if page.data.title %}
            {{ page.data.title }} &middot; {{ global.title }}
        {% else %}
            {{ global.title }}{% if global.description %} &middot; {{ global.description }}{% endif %}
        {% endif %}
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/styles.css' | prepend: global.url }}">
    <link rel="stylesheet" href="{{ '/css/code.css' | prepend: global.url }}">
    <link rel="alternate" type="application/atom+xml" title="{{ global.title }}" href="{{ '/atom.xml' | prepend: global.url }}">
</head>